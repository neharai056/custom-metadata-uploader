{
  "manifest_version": 3,
  "name": "Salesforce Custom Metadata Inserter",
  "version": "1.0.0",
  "description": "Insert Custom Metadata Type (__mdt) records into a Salesforce org directly from your browser.",
  "permissions": ["cookies", "activeTab", "storage"],
  "host_permissions": [
    "*://*.salesforce.com/*",
    "*://*.force.com/*",
    "*://*.salesforce-setup.com/*",
    "*://*.salesforce-sites.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Insert Salesforce Custom Metadata"
  }
}
